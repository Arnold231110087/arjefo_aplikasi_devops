# Salin menjadi .env lalu sesuaikan nilainya (file .env jangan di-commit)
DB_ROOT_PASSWORD=rootpass
DB_NAME=pustakaku
DB_USER=pustaka
DB_PASSWORD=pustakapass
JWT_SECRET=ganti-dengan-rahasia-panjang
ADMIN_EMAIL=admin@pustakaku.id
ADMIN_PASSWORD=admin123
APP_PORT=8080

# Hanya untuk menjalankan TANPA Docker (npm run dev di VS Code + MySQL XAMPP).
# Saat memakai Docker, nilai ini diabaikan karena docker-compose.yml mengisinya sendiri.
DB_HOST=localhost
DB_PORT=3306
PORT=5000

# Hanya untuk docker-compose.prod.yml
DOCKERHUB_USERNAME=usernamedockerhub
TAG=latest
